<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ImmersiveAI.VoiceHost</AssemblyName>
    <RootNamespace>ImmersiveAI.VoiceHost</RootNamespace>

    <!-- x64 ONLY. qwen3_tts.dll and its ggml/CUDA siblings are PE32+; an AnyCPU
         or 32-bit host fails to load them with a bare DllNotFoundException. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Self-contained so a player never has to go and install the .NET runtime, TRIMMED so that
         costs tens of megabytes rather than seventy. Safe here because this program is a plain
         stdout protocol over P/Invoke: no reflection, no serializers, no plugin loading. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantTimezone>true</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- The repo root sets LangVersion 10.0 for the game projects; this is a
         normal desktop app and may use the current language. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- This project must never reference ImmersiveAI.Module (net472 game glue)
         and deliberately stands alone: no Core reference either. -->
  </PropertyGroup>

</Project>
